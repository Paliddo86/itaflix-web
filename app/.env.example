# Copia questo file in .env.local e adatta i valori.
# .env.local NON deve essere committato (vedi .gitignore).

# TMDB API key: usata lato server (Vercel Functions) e, in fallback, dal browser.
TMDB_API=8265bd1679663a7ea12ac168da84d2e8
VITE_TMDB_API=8265bd1679663a7ea12ac168da84d2e8

# Dominio del servizio di streaming (estrazione lato server).
VIX_BASE_URL=https://vixsrc.to

# Metti 1 solo se il browser non riesce a raggiungere vixsrc.to (blocco DNS ISP):
# in quel caso anche manifest e chiave AES passano dal proxy /api/playlist.
VIX_PLAYLIST_PROXY=0
